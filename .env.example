# Local development configuration. Copy only non-secret placeholders from here.
DATABASE_URL=
RAWSTORE_ROOT=

# Bill Commons Scout is dark-launched until both server and web flags are enabled.
BILLCOMMONS_SCOUT_ENABLED=false
NEXT_PUBLIC_SCOUT_ENABLED=false
SOLARI_API_KEY=
BILLCOMMONS_SCOUT_MAX_QUERY_CHARS=500
BILLCOMMONS_SCOUT_MAX_DIRECT_BYTES=262144
BILLCOMMONS_SCOUT_MAX_EXTERNAL_REQUESTS=5
BILLCOMMONS_SCOUT_MAX_RETRIES=1
BILLCOMMONS_SCOUT_CACHE_TTL_SECONDS=3600
BILLCOMMONS_SCOUT_MAX_PDF_PAGES=20
BILLCOMMONS_SCOUT_MAX_PDF_TEXT_CHARS=20000
BILLCOMMONS_SCOUT_LEASE_SECONDS=90
BILLCOMMONS_SCOUT_MAX_PAGES=4
BILLCOMMONS_SCOUT_MAX_ACTIONS=12
BILLCOMMONS_SCOUT_BROWSER_WALL_SECONDS=60
BILLCOMMONS_SCOUT_BROWSER_CLEANUP_SECONDS=10
BILLCOMMONS_SCOUT_REPLAY_WINDOW_SECONDS=600
BILLCOMMONS_SCOUT_REPLAY_ATTEMPTS=5
BILLCOMMONS_SCOUT_MAX_BROWSER_SESSIONS=2
BILLCOMMONS_SCOUT_MAX_ACTIVE_JOBS=2
BILLCOMMONS_SCOUT_MAX_DAILY_JOBS=20
BILLCOMMONS_SCOUT_MAX_DAILY_BROWSER_SECONDS=600

# Optional federal-source development. Obtain a key from api.congress.gov.
CONGRESS_API_KEY=
