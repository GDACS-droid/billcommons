FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./requirements.txt
COPY packages/schema ./packages/schema
COPY packages/shared ./packages/shared
COPY packages/source-registry ./packages/source-registry
COPY workers/ingest ./workers/ingest
COPY data/registry ./data/registry

RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir -e workers/ingest

# Dedicated validation worker: only validates jurisdictions (txn-free external
# HTTP), never touches the fetch_text crawl. Runs as its own Railway service so
# slow validation never starves the crawl worker.
CMD ["python", "-m", "billcommons_ingest", "validate-worker"]
